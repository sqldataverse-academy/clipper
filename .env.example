# ---------- Claude (required) ----------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5

# ---------- Clip settings ----------
DEFAULT_NUM_CLIPS=8
MIN_CLIP_SECONDS=25
MAX_CLIP_SECONDS=60
# Whisper model used for captions on each clip: tiny / base / small / medium
# "small" is a good balance on CPU. Use "medium" if you have an NVIDIA GPU.
WHISPER_MODEL=small
# Whisper device: cpu or cuda
WHISPER_DEVICE=cpu
# Language of your streams for captions, e.g. en, hi. Leave empty to auto-detect.
CAPTION_LANGUAGE=
# Language Claude should write titles/captions in, e.g. English, Hinglish, Hindi
POST_LANGUAGE=English

# ---------- YouTube ----------
# Path to the OAuth client file downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRETS=secrets/client_secret.json
# public / unlisted / private
YOUTUBE_PRIVACY=public

# ---------- Instagram + Facebook (Meta Graph API) ----------
# Long-lived Page access token (see SETUP.md)
META_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_USER_ID=
META_GRAPH_VERSION=v21.0

# ---------- App ----------
DATA_DIR=data
PORT=8000
